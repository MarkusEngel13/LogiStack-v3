# Cloudflare Pages response headers (Vite copies public/ to dist/ as is).
# A private study app: never indexed, never framed. Cloudflare Access does the real locking.
/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# hashed file names: they never change, so browsers may keep them
/assets/*
  Cache-Control: public, max-age=31536000, immutable
